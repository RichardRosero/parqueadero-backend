# Copia este archivo a ".env" y completa tus propios valores

PORT=3000
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# --- Google / Apple login del administrador ---
# TODO: crear proyecto en Google Cloud Console y app en Apple Developer
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# --- WhatsApp Business Cloud API (Meta) ---
# TODO: requiere cuenta de WhatsApp Business API aprobada por Meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Telegram Bot (gratis) ---
# TODO: crear bot con @BotFather en Telegram y pegar el token aqui
TELEGRAM_BOT_TOKEN=

# --- SMS (ej. Twilio u otro proveedor) ---
# TODO: crear cuenta con tu proveedor de SMS preferido
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_FROM=

# --- Google Play Billing / Apple StoreKit ---
# TODO: configurar productos de suscripcion en Play Console / App Store Connect
# y las credenciales de servidor para validar recibos (Real-Time Developer
# Notifications de Google, App Store Server Notifications de Apple)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
APPLE_APP_STORE_SHARED_SECRET=
